# ---- Required ----
# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-key-here

# ---- Optional ----
# DeepSeek compatible base URL and model (defaults shown)
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Firecrawl for live web search in Level 1 fact-check & Level 3 alternatives
# (https://firecrawl.dev — leave empty to disable web search)
FIRECRAWL_API_KEY=

# Path to OpenAI-compatible vision provider config JSON for screenshot analysis:
# {"providers": {"Xiaomi": {"baseUrl": ".../v1", "apiKey": "...", "models": [{"id": "mimo-v2.5"}]}}}
# Leave empty to skip vision extraction (falls back to OCR/heuristic)
MIMO_CONFIG=
